# --- Required ---
NODE_ENV=development
PORT=5000
# Transactions need a replica set (see README). Atlas free tier works out of the box.
MONGO_URI=mongodb://127.0.0.1:27017/imovies?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Exact frontend origin(s), comma-separated, no path or wildcard (CORS + CSRF Origin check + Socket.IO). Invalid values stop startup.
CLIENT_ORIGIN=http://localhost:5173

# --- Cookies (production cross-site deployments need COOKIE_SAMESITE=none + COOKIE_SECURE=true) ---
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# TRUST_PROXY=true

# --- First-admin bootstrap (used by `npm run seed` / `npm run create-admin`) ---
# Creates the admin only if no account has this email. It never promotes an existing customer or resets an existing admin's
# password: if the email is already registered as a CUSTOMER the command aborts (see README, "Admin bootstrap").
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-1
# ADMIN_NAME=iMovies Admin
# Optional demo customer (ignored when NODE_ENV=production)
# SEED_CUSTOMER_EMAIL=customer@example.com
# SEED_CUSTOMER_PASSWORD=change-this-password-1

# --- Tunables (defaults shown) ---
# SEAT_HOLD_MINUTES=10
# MAX_SEATS_PER_BOOKING=8
# CLEANUP_INTERVAL_MS=60000
# TZ_OFFSET_MINUTES=330
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=20
# RESERVE_RATE_LIMIT_MAX=30

# --- Phase 5 ---
# CANCEL_CUTOFF_HOURS=2
# Optional email (booking notifications). Leave unset to skip. "json" builds messages without sending (local demo).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=iMovies <no-reply@example.com>
